// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  createdAt     DateTime        @default(now())
  progress      UserProgress[]
  submissions   Submission[]
  bookmarks     Bookmark[]
  revisions     RevisionQueue[]
}

model Problem {
  id              String          @id
  slug            String          @unique
  title           String
  difficulty      String          // Easy, Medium, Hard
  pillarSlug      String
  timeComplexity  String
  spaceComplexity String
  submissions     Submission[]
  userProgress    UserProgress[]
  revisions       RevisionQueue[]
}

model UserProgress {
  id            String    @id @default(uuid())
  userId        String
  problemSlug   String
  status        String    // COMPLETED, ATTEMPTED
  lastSolvedAt  DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
  problem       Problem   @relation(fields: [problemSlug], references: [slug])
  
  @@unique([userId, problemSlug])
}

model Submission {
  id           String    @id @default(uuid())
  userId       String
  problemSlug  String
  code         String    @db.Text
  language     String    // javascript, python, cpp, java
  status       String    // ACCEPTED, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, RUNTIME_ERROR
  runtime      Int?      // ms
  memory       Float?    // MB
  errorMessage String?   @db.Text
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])
  problem      Problem   @relation(fields: [problemSlug], references: [slug])
}

model Bookmark {
  id          String   @id @default(uuid())
  userId      String
  itemSlug    String   // problem or concept slug
  itemType    String   // PROBLEM, CONCEPT, PATTERN
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemSlug, itemType])
}

model RevisionQueue {
  id          String   @id @default(uuid())
  userId      String
  problemSlug String
  nextDueAt   DateTime
  interval    Int      // current interval in days
  easeFactor  Float    @default(2.5)
  user        User     @relation(fields: [userId], references: [id])
  problem     Problem  @relation(fields: [problemSlug], references: [slug])

  @@unique([userId, problemSlug])
}
